#!/bin/sh
# Hermetic smoke test for the source-build tutorial. It intentionally only
# reads text; no command in the tutorial is executed and no credential store
# or network is touched.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
doc="$root/docs/tutorials/source-build-foreground.md"

fail() {
	echo "docs-smoke: $*" >&2
	exit 1
}

[ -f "$doc" ] || fail "missing $doc"

for required in \
	'cd /absolute/path/to/sf-source' \
	'make build-dev' \
	'./bin/sf-dev auth status' \
	'./bin/sf-dev auth login github' \
	'./bin/sf-dev auth login codex' \
	'./bin/sf-dev init --project nysa --repo /absolute/path/to/nysa-app' \
	'./bin/sf-dev daemon run' \
	'./bin/sf-dev providers qualify --builder codex --reviewer codex' \
	'./bin/sf-dev doctor --repo /absolute/path/to/nysa-app' \
	'./bin/sf-dev submit ./tickets/fix-duplicate-reminders.md --project nysa' \
	'./bin/sf-dev start SF-00000001' \
	'./bin/sf-dev status SF-00000001 --watch'; do
	grep -F -- "$required" "$doc" >/dev/null || fail "missing approved command: $required"
done

line() { grep -nF -- "$1" "$doc" | head -n 1 | cut -d: -f1; }
build_line=$(line 'make build-dev')
auth_line=$(line './bin/sf-dev auth status')
init_line=$(line './bin/sf-dev init --project nysa --repo /absolute/path/to/nysa-app')
daemon_line=$(line './bin/sf-dev daemon run')
qualify_line=$(line './bin/sf-dev providers qualify --builder codex --reviewer codex')
doctor_line=$(line './bin/sf-dev doctor --repo /absolute/path/to/nysa-app')
submit_line=$(line './bin/sf-dev submit ./tickets/fix-duplicate-reminders.md --project nysa')
start_line=$(line './bin/sf-dev start SF-00000001')
[ "$build_line" -lt "$auth_line" ] || fail 'build must precede auth'
[ "$auth_line" -lt "$init_line" ] || fail 'auth must precede init'
[ "$init_line" -lt "$daemon_line" ] || fail 'init must precede daemon startup'
[ "$daemon_line" -lt "$qualify_line" ] || fail 'daemon startup must precede qualification'
[ "$qualify_line" -lt "$doctor_line" ] || fail 'qualification must precede doctor'
[ "$doctor_line" -lt "$submit_line" ] || fail 'doctor must precede submit'
[ "$submit_line" -lt "$start_line" ] || fail 'submit must precede start'

for forbidden in 'gh auth token' 'Authorization:' 'curl ' 'wget ' 'git clone ' '--danger-full-access'; do
	grep -F -- "$forbidden" "$doc" >/dev/null && fail "unsafe or network-bearing text: $forbidden"
done

grep -F -- 'does not send a displayed token' "$doc" >/dev/null || fail 'credential boundary missing'
grep -F -- 'does not invoke `gh`, a provider, a daemon, a network' "$doc" >/dev/null || fail 'hermetic check contract missing'

# The self-serve guide must establish a binary and one coherent pair before
# registration. These assertions inspect text only; they do not claim a human
# completed setup or that any provider/remote is available.
doc="$root/docs/tutorials/first-ticket.md"
[ -f "$doc" ] || fail "missing $doc"
for required in \
	'export PATH="/absolute/path/to/sf-source/bin:$PATH"' \
	'sf-dev auth login claude' \
	'sf-dev init --providers claude-codex' \
	'sf-dev providers qualify --preset claude-codex' \
	'sf-dev start --project my-app --accept-cost-estimates' \
	'Automated clean-environment tests and an' ; do
	grep -F -- "$required" "$doc" >/dev/null || fail "missing first-use contract: $required"
done
[ "$(line 'make build-dev')" -lt "$(line 'sf-dev init --check')" ] || fail 'first-use build must precede preview'
[ "$(line 'sf-dev init --providers claude-codex')" -lt "$(line 'sf-dev daemon run')" ] || fail 'first-use registration must precede daemon'
[ "$(line 'sf-dev daemon run')" -lt "$(line 'sf-dev providers qualify --preset claude-codex')" ] || fail 'first-use daemon must precede qualification'
[ "$(line 'sf-dev providers qualify --preset claude-codex')" -lt "$(line 'sf-dev run ticket.md')" ] || fail 'first-use qualification must precede run'
grep -F -- './bin/sf-dev' "$doc" >/dev/null && fail 'first-use guide switches binary location after PATH setup'
echo 'docs-smoke: PASS (read-only, credential-free, network-free)'

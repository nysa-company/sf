#!/usr/bin/env python3
"""Run a pinned Gitleaks scan of repository history and working files."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import sys
import tarfile
import tempfile
import urllib.request


VERSION = "8.30.1"
ARTIFACTS = {
    ("Darwin", "arm64"): ("darwin_arm64", "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"),
    ("Darwin", "x86_64"): ("darwin_x64", "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"),
    ("Linux", "aarch64"): ("linux_arm64", "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"),
    ("Linux", "x86_64"): ("linux_x64", "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"),
}
SHA = re.compile(r"[0-9a-f]{40}")


def fail(message: str) -> "NoReturn":
    print(f"secret-scan: {message}", file=sys.stderr)
    raise SystemExit(2)


def find_root(start: Path) -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], cwd=start, text=True, capture_output=True
    )
    if result.returncode:
        fail("run inside a git repository")
    return Path(result.stdout.strip())


def install(root: Path) -> Path:
    override = os.environ.get("GITLEAKS_BIN")
    if override:
        binary = Path(override)
        if not binary.is_file() or not os.access(binary, os.X_OK):
            fail("GITLEAKS_BIN is not executable")
        return binary
    key = (platform.system(), platform.machine())
    if key not in ARTIFACTS:
        fail(f"unsupported platform: {key[0]} {key[1]}")
    suffix, expected = ARTIFACTS[key]
    cache = root / ".context" / "tools" / "gitleaks" / VERSION
    archive = cache / "gitleaks.tar.gz"
    target = cache / "gitleaks"
    cache.mkdir(parents=True, exist_ok=True)
    url = f"https://github.com/gitleaks/gitleaks/releases/download/v{VERSION}/gitleaks_{VERSION}_{suffix}.tar.gz"
    if not archive.is_file() or hashlib.sha256(archive.read_bytes()).hexdigest() != expected:
        print(f"secret-scan: installing pinned Gitleaks v{VERSION} in .context/tools")
        with tempfile.TemporaryDirectory() as tmp:
            downloaded = Path(tmp) / "gitleaks.tar.gz"
            try:
                urllib.request.urlretrieve(url, downloaded)
            except OSError as exc:
                fail(f"could not download pinned scanner: {exc}")
            actual = hashlib.sha256(downloaded.read_bytes()).hexdigest()
            if actual != expected:
                fail("download checksum mismatch")
            archive.write_bytes(downloaded.read_bytes())
    try:
        with tarfile.open(archive, "r:gz") as bundle:
            member = next((m for m in bundle.getmembers() if Path(m.name).name == "gitleaks" and m.isfile()), None)
            if member is None:
                fail("scanner archive did not contain gitleaks")
            extracted = bundle.extractfile(member)
            if extracted is None:
                fail("could not read gitleaks from scanner archive")
            verified_binary = extracted.read()
    except (OSError, tarfile.TarError) as exc:
        fail(f"could not read verified scanner archive: {exc}")
    if not target.is_file() or target.read_bytes() != verified_binary:
        try:
            target.write_bytes(verified_binary)
        except OSError as exc:
            fail(f"could not cache pinned scanner: {exc}")
    try:
        target.chmod(0o755)
    except OSError as exc:
        fail(f"could not make cached scanner executable: {exc}")
    return target


def overlay_config(root: Path, directory: Path) -> Path:
    explicit = os.environ.get("GITLEAKS_CONFIG")
    inline = os.environ.get("GITLEAKS_CONFIG_TOML")
    repository = root / ".gitleaks.toml"
    base = None
    if explicit:
        base = Path(explicit).expanduser().resolve()
    elif inline:
        base = directory / "environment.toml"
        base.write_text(inline, encoding="utf-8")
    elif repository.is_file():
        base = repository.resolve()

    extend = f"path = {json.dumps(str(base))}" if base else "useDefault = true"
    overlay = directory / "nysa-gitleaks.toml"
    overlay.write_text(
        f"""title = "Nysa secret scan overlay"

[extend]
{extend}

[[allowlists]]
description = "Baseline receipt contains SHA-256 ownership hashes, not credentials"
condition = "AND"
targetRules = ["generic-api-key"]
paths = ['''(^|/)\\.agents/repo-standard\\.json$''']
regexes = ['''^[0-9a-f]{{64}}$''']
""",
        encoding="utf-8",
    )
    return overlay


def run(binary: Path, root: Path, mode: str, history_range: str | None = None) -> int:
    with tempfile.TemporaryDirectory() as tmp:
        config = overlay_config(root, Path(tmp))
        commands = []
        common = [
            str(binary), "--redact", "--no-banner", "--exit-code", "1",
            "--config", str(config),
        ]
        if mode in ("all", "history"):
            command = common + ["git"]
            if history_range:
                command += ["--log-opts", history_range]
            commands.append(command + [str(root)])
        if mode in ("all", "directory"):
            commands.append(common + ["dir", str(root)])
        for command in commands:
            result = subprocess.run(command)
            if result.returncode:
                print("secret-scan: FAIL (findings are redacted)", file=sys.stderr)
                return result.returncode
    print("secret-scan: PASS")
    return 0


def github_pull_request_range() -> str | None:
    if os.environ.get("GITHUB_EVENT_NAME") != "pull_request":
        return None
    event_path = os.environ.get("GITHUB_EVENT_PATH")
    if not event_path:
        fail("pull-request event path is missing")
    try:
        event = json.loads(Path(event_path).read_text(encoding="utf-8"))
        base = event["pull_request"]["base"]["sha"]
        head = event["pull_request"]["head"]["sha"]
    except (KeyError, OSError, TypeError, json.JSONDecodeError):
        fail("pull-request event is invalid")
    if not isinstance(base, str) or not isinstance(head, str) or not SHA.fullmatch(base) or not SHA.fullmatch(head):
        fail("pull-request commit SHAs are invalid")
    return f"{base}..{head}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("all", "history", "directory"), default="all")
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--base")
    parser.add_argument("--head")
    args = parser.parse_args()
    root = find_root(args.root.resolve())
    if bool(args.base) != bool(args.head):
        fail("--base and --head must be provided together")
    if args.base and not all(SHA.fullmatch(value) for value in (args.base, args.head)):
        fail("--base and --head must be lowercase 40-character commit SHAs")
    history_range = f"{args.base}..{args.head}" if args.base else github_pull_request_range()
    return run(install(root), root, args.mode, history_range)


if __name__ == "__main__":
    raise SystemExit(main())
